# Release signing config for the branded Quest apps. COPY this file to `keystore.properties`
# (same directory) and fill in real values. keystore.properties and the keystore itself are
# gitignored — they are secrets and must never be committed.
#
# Generate a release keystore once (keep it + the passwords backed up FOREVER — once an app is
# uploaded to the Meta store, every future update MUST be signed with this same key):
#
#   & "$env:JAVA_HOME\bin\keytool.exe" -genkeypair -v \
#       -keystore android/release.keystore -alias alephone \
#       -keyalg RSA -keysize 2048 -validity 10000 \
#       -dname "CN=Aleph One VR, O=Aleph One"
#
# storeFile is resolved relative to the android/ project root.

storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=alephone
keyPassword=CHANGE_ME
